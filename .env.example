# Database Configuration
# In docker: postgresql://peblo_user:peblo_pass@postgres:5432/peblo_tv
# In local development without docker: postgresql://peblo_user:peblo_pass@localhost:5432/peblo_tv
DATABASE_URL=postgresql://peblo_user:peblo_pass@postgres:5432/peblo_tv

# Security / JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-development-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Storage & Catalogue Paths (Local Storage abstraction)
# Note: In production, StorageBackend will connect to Cloudflare R2 / S3 using S3 credentials
STORAGE_PATH=./storage
CATALOGUE_PATH=./storage/catalogue.json

# CORS Configuration (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Seed User Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123
EDITOR_EMAIL=editor@example.com
EDITOR_PASSWORD=editorpassword123

# Environment
ENVIRONMENT=development
