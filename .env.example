# ==============================================================================
# Peblo TV Mini — Environment Configuration Template
# Copy this file to .env before running locally or configuring production.
# ==============================================================================

# Project & Environment
PROJECT_NAME="Peblo TV Mini"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Connection (PostgreSQL or SQLite)
# PostgreSQL: postgresql://peblo_user:peblo_pass@localhost:5432/peblo_tv
# SQLite (Local): sqlite:///./peblo_local.db
DATABASE_URL="postgresql://peblo_user:peblo_pass@localhost:5432/peblo_tv"

# JWT Authentication & Security
# IMPORTANT: Generate a cryptographically secure random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="your-secure-jwt-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=1440

# Storage Layer & Catalogue Paths
STORAGE_PATH="./storage"
CATALOGUE_PATH="./storage/catalogue.json"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# Default Demo Seed Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="adminpassword123"
EDITOR_EMAIL="editor@example.com"
EDITOR_PASSWORD="editorpassword123"

# Frontend Vite Configuration
VITE_API_URL="http://localhost:8000"
