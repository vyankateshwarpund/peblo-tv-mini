# ==============================================================================
# Peblo TV Mini — Environment Configuration Template
# Copy this file to .env before running locally or configuring production.
# ==============================================================================

# Project & Environment
PROJECT_NAME="Peblo TV Mini"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Connection (PostgreSQL or SQLite)
# PostgreSQL: postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
# SQLite (Local): sqlite:///./peblo_local.db
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>"

# JWT Authentication & Security
# IMPORTANT: Generate a cryptographically secure random string in production:
#   openssl rand -hex 32
JWT_SECRET="<your-random-256-bit-secret-here>"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=1440

# Storage Layer & Catalogue Paths
STORAGE_PATH="./storage"
CATALOGUE_PATH="./storage/catalogue.json"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# Admin & Editor Seed Credentials (change before deploying)
ADMIN_EMAIL="<admin-email@yourdomain.com>"
ADMIN_PASSWORD="<strong-admin-password>"
EDITOR_EMAIL="<editor-email@yourdomain.com>"
EDITOR_PASSWORD="<strong-editor-password>"

# Frontend Vite Configuration
VITE_API_URL="http://localhost:8000"
